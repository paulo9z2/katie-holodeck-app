<Window x:Class="KatieHoloDeck.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KatieHoloDeck"
        Title="KATIE Player" Height="112" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0">
    <!-- F2.7 — host glass F2B (padrão 00705b4): o Border NÃO pinta fill nem traço
         (Background={x:Null}, BorderThickness=0). O fill único é o Path em sangria, com
         raio PURO de 16 (Chamfer=0 → Glass.ApplyFace lê host.CornerRadius e fecha o canto
         arredondado). OFF = ThemePlayerSurfaceBrush (#E6101A30 original) + FallbackStroke
         #3300FF88; ON = IslandGlass + aro de cristal. O Grid externo Transparent existe só
         para hit-test/drag do TitleBar — ele não pinta nada. -->
    <Border x:Name="PlayerGlassHost" CornerRadius="16" Background="{x:Null}"
            BorderBrush="{DynamicResource ThemePlayerEdgeBrush}" BorderThickness="0" Padding="0"
            local:Chamfer.Size="0" local:Glass.Ring="True">
        <Border.Effect>
            <DropShadowEffect Color="#00FF88" BlurRadius="26" ShadowDepth="0" Opacity="0.30"/>
        </Border.Effect>
        <Grid Background="Transparent">
            <Path local:Glass.Face="ThemePlayerSurfaceBrush"
                  local:Glass.FaceFrosted="IslandGlass"
                  local:Glass.FallbackStroke="ThemePlayerEdgeBrush"
                  Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsHitTestVisible="False"/>
            <!-- margem 1 = BorderThickness antigo; preserva a posição do conteúdo no OFF -->
            <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="TitleBar" Grid.Row="0" Height="22" CornerRadius="16,16,0,0" Background="#0AFFFFFF"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="KATIE · MÚsICA" FontFamily="Consolas" FontSize="8" Foreground="#FF6C85A8"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Width="18" Height="15" CornerRadius="4" Background="#20FF3B3B" HorizontalAlignment="Right"
                            Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CloseBtn_Click">
                        <TextBlock Text="✕" Foreground="#FFFF3B3B" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="12,6,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="CoverArt" Grid.Column="0" Width="64" Height="64" RadiusX="10" RadiusY="10" Fill="#331E4E8C"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- v9.7 (Selo de Origem): nome da faixa + ícone do app que está tocando (inline, no fim) -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TrackTitle" Text="Nada tocando" FontFamily="Consolas" FontSize="12" Foreground="#FFF2F6FF" TextTrimming="CharacterEllipsis" MaxWidth="256"/>
                        <Image x:Name="SourceIcon" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Uniform" Opacity="0" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="SourceIcon_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TrackArtist" Text="—" FontFamily="Consolas" FontSize="10" Foreground="#FF6C85A8" TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,7,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Text="0:00" FontFamily="Consolas" FontSize="8" Foreground="#FF40546E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border x:Name="ProgressTrack" Grid.Column="1" Height="3" CornerRadius="1.5" Background="#1400FF88" VerticalAlignment="Center">
                            <Border x:Name="ProgressFill" Height="3" CornerRadius="1.5" Background="#FF00FF88" HorizontalAlignment="Left" Width="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF88" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <TextBlock Grid.Column="2" x:Name="DurText" Text="0:00" FontFamily="Consolas" FontSize="8" Foreground="#FF40546E" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Border x:Name="BtnPrev" Width="26" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrushGhost}" BorderBrush="#3300FF88" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="Prev_Click">
                            <TextBlock Text="⏮" Foreground="#FF9FB0C8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnPlay" Width="32" Height="24" CornerRadius="7" Background="#3300FF88" BorderBrush="#FF00FF88" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Play_Click">
                            <TextBlock x:Name="PlayIcon" Text="⏸" Foreground="#FF00FF88" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnNext" Width="26" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrushGhost}" BorderBrush="#3300FF88" BorderThickness="1" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="Next_Click">
                            <TextBlock Text="⏭" Foreground="#FF9FB0C8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="🔊" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Slider x:Name="VolSlider" Width="70" VerticalAlignment="Center" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}"
                                Thumb.DragStarted="Vol_DragStarted" Thumb.DragCompleted="Vol_DragCompleted" ValueChanged="Vol_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>