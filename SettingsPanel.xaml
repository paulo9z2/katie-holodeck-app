<UserControl xmlns:local="clr-namespace:KatieHoloDeck" x:Class="KatieHoloDeck.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">

    <UserControl.Resources>

        <!-- ===== item de navegação / opção (radio) ===== -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="Bar" Width="3" Height="14" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <ContentPresenter Margin="12,7,8,7" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrushGhost}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrushFaint}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== botão fantasma (ações secundárias) ===== -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Padding="12,7"
                                Background="{DynamicResource AccentBrushGhost}"
                                BorderBrush="{DynamicResource AccentBrushFaint}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentBrushFaint}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentBrushDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== amostra de cor (radio) ===== -->
        <Style x:Key="SwatchRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                     Margin="-4" Opacity="0"/>
                            <Ellipse Width="26" Height="26" Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== checkbox Fluent (caixa 16 r4 + tick) ===== -->
        <Style x:Key="FluentCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    BorderBrush="{DynamicResource ThemeTextDimBrush}" BorderThickness="1" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 3,8 L 6.5,11.5 L 13,4"
                                      Stroke="#FF061018" StrokeThickness="2" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== pill radio (intervalos) ===== -->
        <Style x:Key="PillRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="11" Padding="12,5" Background="Transparent"
                                BorderBrush="{DynamicResource AccentBrushGhost}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentBrushGhost}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentBrushFaint}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== casca de campo de texto (input fino r6) ===== -->
        <Style x:Key="FieldShellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldGlassBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- rótulos padrão -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextStrongBrush}"/>
        </Style>

        <Style x:Key="SectionSubStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeLabelBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,16"/>
        </Style>

        <Style x:Key="HairlineStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource AccentBrushGhost}"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#FFFF6B6B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

    </UserControl.Resources>

    <!-- ===== cartão central das Configurações (v9.3: FUNDO SÓLIDO — spec do sir 18/10:
         zero transparência; o "recuo" do resto da janela vem do blur real do AppContent).
         F1: o fundo sólido agora é um Path OCTOGONAL (Chamfer.Octagon) — o Border não pinta
         retângulo nem traço arredondado; o aro vem do Glass (neutro) quando o vidro está ON. ===== -->
    <Border x:Name="PanelCard"
            Style="{StaticResource FloatingIslandStyle}"
            Background="{x:Null}"
            BorderBrush="{DynamicResource PanelEdgeLiveBrush}"
            BorderThickness="0"
            CornerRadius="14"
            Padding="0" local:Chamfer.Size="16" local:TechFrame.Enabled="True" local:Glass.Ring="True">
        <!-- F3.2: o Grid raiz recebe Background="Transparent" (padrão F2B) para o retângulo
             inteiro do cartão ficar no hit-test — sem isto o clique nos cantos chanfrados
             (fora do octógono) atravessava e caía no SettingsScrim, fechando o painel. -->
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Stretch="Fill": a geometria é construída em px reais (0,0,w,h) e o Path
                 esticado no mesmo tamanho dá escala 1:1. Com "None" o Path mediria a
                 própria geometria (nula no primeiro passe) e nunca sairia de 0×0.
                 F1-PAINT: SEM FallbackStroke — o cartão TEM chanfro (Chamfer.Size=16) e o
                 ChamferAdorner já pinta o contorno octogonal na silhueta. O FallbackStroke
                 (1 px a 0,5 px por dentro) duplicava a linha = contorno duplo. -->
            <Path local:Glass.Face="ThemePanelSolidBrush"
                  local:Glass.FaceFrosted="IslandGlass"
                  Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsHitTestVisible="False"/>
            <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource SurfaceTintBrush}" IsHitTestVisible="False"
                       local:Glass.DimWhenGlass="True"/>

            <!-- ===== NAVEGAÇÃO ===== -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource AccentBrushGhost}">
                <DockPanel Margin="14,16,14,14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="◈ CONFIGURAÇÕES" FontFamily="Consolas" FontSize="10"
                                   Foreground="{DynamicResource ThemeLabelBrush}" Margin="4,0,0,14"/>
                        <RadioButton x:Name="NavAparencia" Style="{StaticResource NavItemStyle}" Content="Aparência" Tag="aparencia" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavEfeitos" Style="{StaticResource NavItemStyle}" Content="Efeitos e desempenho" Tag="efeitos" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavJogos" Style="{StaticResource NavItemStyle}" Content="Jogos e atividade" Tag="jogos" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMusica" Style="{StaticResource NavItemStyle}" Content="Música" Tag="musica" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavConversa" Style="{StaticResource NavItemStyle}" Content="Conversa" Tag="conversa" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTelemetria" Style="{StaticResource NavItemStyle}" Content="Telemetria" Tag="telemetria" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSistema" Style="{StaticResource NavItemStyle}" Content="Sistema" Tag="sistema" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGeral" Style="{StaticResource NavItemStyle}" Content="Geral e acessibilidade" Tag="geral" Checked="Nav_Checked"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="RestoreDefaultsBtn" Style="{StaticResource GhostButtonStyle}"
                                Content="Restaurar padrões" Click="RestoreDefaults_Click"/>
                        <TextBlock Text="as alterações aplicam na hora e ficam salvas em settings.json"
                                   Style="{StaticResource InfoTextStyle}" Margin="2,8,2,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== CONTEÚDO ===== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,18,18,18">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <Grid>
                    <!-- ~~~~~~~~~~~~~~~~ APARÊNCIA ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecAparencia">
                        <TextBlock Text="Aparência" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="cor principal do acento — bordas das ilhas, glows, destaques e controles mudam na hora."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <TextBlock Text="Cor principal" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Sw1" Style="{StaticResource SwatchRadioStyle}" Background="#FF00D9FF" Tag="#FF00D9FF" ToolTip="Ciano elétrico (padrão)" AutomationProperties.Name="Cor Ciano padrão" Checked="Swatch_Checked"/>
                            <RadioButton x:Name="Sw2" Style="{StaticResource SwatchRadioStyle}" Background="#FFA25CFF" Tag="#FFA25CFF" ToolTip="Roxo neon" AutomationProperties.Name="Cor Roxo neon" Checked="Swatch_Checked"/>
                            <RadioButton x:Name="Sw3" Style="{StaticResource SwatchRadioStyle}" Background="#FF00FF88" Tag="#FF00FF88" ToolTip="Verde Matrix" AutomationProperties.Name="Cor Verde Matrix" Checked="Swatch_Checked"/>
                            <RadioButton x:Name="Sw4" Style="{StaticResource SwatchRadioStyle}" Background="#FFFFB454" Tag="#FFFFB454" ToolTip="Âmbar" AutomationProperties.Name="Cor Âmbar" Checked="Swatch_Checked"/>
                            <RadioButton x:Name="Sw5" Style="{StaticResource SwatchRadioStyle}" Background="#FFFF5CA8" Tag="#FFFF5CA8" ToolTip="Magenta" AutomationProperties.Name="Cor Magenta" Checked="Swatch_Checked"/>
                        </StackPanel>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <TextBlock Text="HEX personalizado" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource FieldShellStyle}" Width="150">
                                <TextBox x:Name="HexBox" Style="{StaticResource FluentTextBoxStyle}" Padding="9,6"
                                         FontFamily="Consolas" FontSize="12" MaxLength="9" KeyDown="HexBox_KeyDown"
                                         AutomationProperties.Name="Cor HEX personalizada"/>
                            </Border>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="aplicar" Margin="8,0,0,0" Click="ApplyHex_Click"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="restaurar cor padrão" Margin="8,0,0,0" Click="ResetAccent_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="HexErr" Style="{StaticResource ErrorTextStyle}"/>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <!-- F1: aro de cristal (T2, vetorial). Default OFF = visual do v9.8.2. -->
                        <TextBlock Text="Material" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox x:Name="GlassChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  AutomationProperties.Name="Aro de cristal"
                                  Content="Aro de cristal (vidro vetorial no painel de música e no cartão de Configurações)"
                                  Checked="Glass_Toggled" Unchecked="Glass_Toggled"/>
                        <TextBlock x:Name="GlassModeInfo" Style="{StaticResource InfoTextStyle}" Margin="0,3,0,8"/>
                        <TextBlock Text="aro 1 px branco neutro + faceta 45° + specular só na faceta superior-esquerda (luz −24°). sem acento na face, sem glow, sem véu."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ EFEITOS ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecEfeitos" Visibility="Collapsed">
                        <TextBlock Text="Efeitos e desempenho" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="quanto de movimento e sombra o app usa — vale para acessibilidade e para máquinas mais fracas."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <RadioButton x:Name="OptFull" Style="{StaticResource NavItemStyle}" Tag="full" Checked="Profile_Checked" Content="Completo — radar 60 fps, sombras de ilha, transições com subida"/>
                        <RadioButton x:Name="OptReduced" Style="{StaticResource NavItemStyle}" Tag="reduced" Checked="Profile_Checked" Content="Reduzido — sombras leves, radar a 50%, transições só com fade"/>
                        <RadioButton x:Name="OptNone" Style="{StaticResource NavItemStyle}" Tag="none" Checked="Profile_Checked" Content="Sem animações — radar parado, abertura direta dos painéis"/>

                        <TextBlock Text="“Sem animações” também desliga o loop de 60 fps do núcleo (menos GPU/CPU em idle)."
                                   Style="{StaticResource InfoTextStyle}" Margin="0,10,0,0"/>

                        <CheckBox x:Name="ReactorMotionChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  AutomationProperties.Name="Movimento do reator"
                                  Content="Movimento do reator (animação autônoma do núcleo e dos anéis)"
                                  Checked="ReactorMotion_Toggled" Unchecked="ReactorMotion_Toggled"/>
                        <TextBlock Text="desligado: anéis param e o núcleo não pulsa sozinho — tilt, zoom e resposta a input continuam."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ JOGOS ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecJogos" Visibility="Collapsed">
                        <TextBlock Text="Jogos e atividade" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="detecção local por nome de processo — sem admin, sem hooks e nada sai desta máquina."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <CheckBox x:Name="GameDetectChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Detecção de jogos ativa" Checked="GameDetect_Toggled" Unchecked="GameDetect_Toggled"/>
                        <TextBlock Text="“em execução” = processo aberto (mesmo em segundo plano) · “jogando agora” = janela do jogo em primeiro plano."
                                   Style="{StaticResource InfoTextStyle}"/>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <TextBlock Text="Jogos monitorados" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel x:Name="GamesRows"/>

                        <TextBlock Text="adicionar jogo" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource FieldShellStyle}" Width="180">
                                <TextBox x:Name="GameNameBox" Style="{StaticResource FluentTextBoxStyle}" Padding="9,6"
                                         FontFamily="Segoe UI Variable Text" FontSize="12" MaxLength="40"
                                         AutomationProperties.Name="Nome do jogo"/>
                            </Border>
                            <Border Style="{StaticResource FieldShellStyle}" Width="220" Margin="8,0,0,0">
                                <TextBox x:Name="GameProcBox" Style="{StaticResource FluentTextBoxStyle}" Padding="9,6"
                                         FontFamily="Consolas" FontSize="12" MaxLength="120"
                                         AutomationProperties.Name="Processo do jogo"
                                         ToolTip="nome do processo (ex.: hollow_knight.exe); aceita vários separados por vírgula"/>
                            </Border>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="adicionar" Margin="8,0,0,0" Click="AddGame_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GameAddErr" Style="{StaticResource ErrorTextStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="TestGamesBtn" Style="{StaticResource GhostButtonStyle}"
                                    Content="testar agora" Click="TestGames_Click"/>
                            <TextBlock x:Name="GameTestResult" FontFamily="Segoe UI Variable Text" FontSize="11"
                                       Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="o teste faz uma varredura única agora e mostra exatamente o que a detecção veria."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ MÚSICA ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecMusica" Visibility="Collapsed">
                        <TextBlock Text="Música" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="o painel usa os metadados reais do Windows (SMTC) — capa, título e controles do player ativo."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <CheckBox x:Name="MusicAnimChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Animar abertura/fechamento do painel de música" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <CheckBox x:Name="MusicUndockChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Mostrar botão de desancorar (janela flutuante)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <CheckBox x:Name="MusicCoverAllChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Música cobre tudo (telemetria e conversa ficam sob o painel, borradas)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <CheckBox x:Name="MusicThemeChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  AutomationProperties.Name="Tema da capa"
                                  Content="Tema da capa (o app inteiro segue as cores dominantes da música)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <TextBlock Text="desligado: ilhas, chat, gauges, HUD e player voltam ao tema ciano padrão. a troca de faixa faz crossfade de 600 ms."
                                   Style="{StaticResource InfoTextStyle}"/>
                        <CheckBox x:Name="MusicAccentChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Cores da música (acento segue a cor dominante da capa)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <CheckBox x:Name="MusicWheelChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Roda de música ao redor do reator (64 bandas audio-reativas)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>
                        <CheckBox x:Name="MusicRingsChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Anéis girantes da roda (um no sentido horário, outro anti-horário)" Checked="Music_Toggled" Unchecked="Music_Toggled"/>

                        <TextBlock Text="Sensibilidade da roda" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/>
                        <Grid Width="320" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MusicSensitivitySlider" Style="{StaticResource FluentSliderStyle}"
                                    Minimum="1" Maximum="20" Value="1" SmallChange="1" LargeChange="2"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ValueChanged="MusicSensitivity_Changed"
                                    AutomationProperties.Name="Sensibilidade da roda de música"/>
                            <TextBlock x:Name="MusicSensitivityValue" Grid.Column="1" Text="1" Width="30"
                                       FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Cálculo de pico" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/>
                        <ComboBox x:Name="MusicCalcCombo" Style="{StaticResource FluentComboBoxStyle}" Width="200"
                                  HorizontalAlignment="Left" SelectionChanged="MusicCalc_Changed"
                                  AutomationProperties.Name="Cálculo de pico">
                            <ComboBoxItem Content="Max" Tag="max"/>
                            <ComboBoxItem Content="Median" Tag="median"/>
                            <ComboBoxItem Content="Mean" Tag="mean"/>
                        </ComboBox>

                        <TextBlock Text="com a animação desligada o painel aparece direto, sem subida/escala. a cor da capa entra com transição suave; sem música o acento volta ao seu ajuste. a roda só aparece enquanto o SMTC estiver tocando."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ CONVERSA ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecConversa" Visibility="Collapsed">
                        <TextBlock Text="Conversa" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="comportamento do compositor e do histórico."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <CheckBox x:Name="ChatFocusChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Manter o cursor no campo de digitação após enviar" Checked="Chat_Toggled" Unchecked="Chat_Toggled"/>
                        <CheckBox x:Name="ChatScrollChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Rolar automaticamente quando chegar mensagem nova" Checked="Chat_Toggled" Unchecked="Chat_Toggled"/>
                        <CheckBox x:Name="ChatOnTopChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Manter a janela sempre no topo (acima dos outros apps)" Checked="Chat_Toggled" Unchecked="Chat_Toggled"/>
                        <TextBlock Text="Enter envia · envios vazios são ignorados · a resposta chega via state.json."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ TELEMETRIA ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecTelemetria" Visibility="Collapsed">
                        <TextBlock Text="Telemetria" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="o que aparece no painel lateral e com que frequência os dados são lidos."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <TextBlock Text="Frequência de atualização" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OptInt2" Style="{StaticResource PillRadioStyle}" Content="2 s" Tag="2" Checked="Interval_Checked"/>
                            <RadioButton x:Name="OptInt5" Style="{StaticResource PillRadioStyle}" Content="5 s" Tag="5" Checked="Interval_Checked"/>
                            <RadioButton x:Name="OptInt10" Style="{StaticResource PillRadioStyle}" Content="10 s" Tag="10" Checked="Interval_Checked"/>
                        </StackPanel>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <CheckBox x:Name="TelGpuChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Mostrar GPU (nvidia-smi quando disponível)" Checked="Telemetry_Toggled" Unchecked="Telemetry_Toggled"/>
                        <CheckBox x:Name="TelNetChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Mostrar rede (throughput real ↑/↓, não é ping)" Checked="Telemetry_Toggled" Unchecked="Telemetry_Toggled"/>
                        <TextBlock Text="sem nvidia-smi no PATH o GPU aparece como n/a — nenhum dado é inventado."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ SISTEMA (v7 Fase C — métricas da sessão) ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecSistema" Visibility="Collapsed">
                        <TextBlock Text="Sistema" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="métricas da sessão atual e custo comparativo do motor local."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <TextBlock Text="SESSÃO" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Requests" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="SysRequests" Grid.Row="0" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Output tokens" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="SysTokens" Grid.Row="1" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Potência do motor" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="SysPower" Grid.Row="2" Grid.Column="1" Text="n/a" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Latência da última" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock x:Name="SysLatency" Grid.Row="3" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="24,0,0,0"/>
                        </Grid>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <TextBlock Text="CUSTO COMPARATIVO" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Local (Ollama)" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="$0.0000" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ThemeSecondaryBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPT-5.3 (equivalente)" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ThemeTextDimBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Claude Opus (equivalente)" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ThemeTextDimBrush}" Margin="24,0,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gemini Pro (equivalente)" Style="{StaticResource InfoTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ThemeTextDimBrush}" Margin="24,0,0,0"/>
                        </Grid>
                        <TextBlock Text="estimativas de custo chegam com o motor local ativo (Fase D). zeros não são inventados."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>

                    <!-- ~~~~~~~~~~~~~~~~ GERAL ~~~~~~~~~~~~~~~~ -->
                    <StackPanel x:Name="SecGeral" Visibility="Collapsed">
                        <TextBlock Text="Geral e acessibilidade" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="inicialização e informações do aplicativo."
                                   Style="{StaticResource SectionSubStyle}"/>

                        <CheckBox x:Name="StartMinChk" Style="{StaticResource FluentCheckBoxStyle}"
                                  Content="Iniciar minimizado (aplica no próximo início do app)" Checked="General_Toggled" Unchecked="General_Toggled"/>

                        <Rectangle Style="{StaticResource HairlineStyle}"/>

                        <TextBlock x:Name="InfoVersion" Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock x:Name="InfoPath" Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock Text="state.json / command.json ficam na mesma pasta (integração da KATIE via API local)."
                                   Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock Text="Atalhos: Tab navega · Enter aciona · Esc fecha este painel."
                                   Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock Text="Movimento reduzido do Windows é respeitado no primeiro início; você pode forçar “Sem animações” em Efeitos."
                                   Style="{StaticResource InfoTextStyle}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
