<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- offline: 100% WPF puro (Shapes/Effects/DispatcherTimer), zero pacotes NuGet -->
    <ApplicationIcon>katie_holodeck.ico</ApplicationIcon>
    <AssemblyName>KatieHoloDeck</AssemblyName>
    <RootNamespace>KatieHoloDeck</RootNamespace>
    <!-- snapshot de versão: Fluent Glass (fases 1-6) + reator v2 -->
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Orbitron.ttf" />
  </ItemGroup>
</Project>
